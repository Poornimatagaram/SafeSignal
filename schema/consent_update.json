{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schema/consent_update.json",
  "title": "SentinelConsentUpdate",
  "description": "Sent to PUT /v1/consent/{patient_ref}. Names the care-team organization, the caregiver, and (only with emergency_consent) emergency organizations and up to 3 user-defined emergency contacts. No free text: contact names stay on the device (D-064, D-067).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patient_ref",
    "care_org_id",
    "share_care_team",
    "caregiver_id",
    "share_caregiver",
    "caregiver_detail",
    "emergency_consent",
    "emergency_org_ids",
    "emergency_contacts"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "patient_ref": {
      "type": "string",
      "pattern": "^pt_[a-f0-9]{8}$"
    },
    "care_org_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^org_[a-f0-9]{8}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "share_care_team": {
      "type": "boolean"
    },
    "caregiver_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cg_[a-f0-9]{8}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "share_caregiver": {
      "type": "boolean"
    },
    "caregiver_detail": {
      "enum": [
        "alerts_only",
        "summary"
      ]
    },
    "emergency_consent": {
      "type": "boolean"
    },
    "emergency_org_ids": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^org_[a-f0-9]{8}$"
      }
    },
    "emergency_contacts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contact_id",
          "contact_type",
          "phone",
          "org_id",
          "priority"
        ],
        "properties": {
          "contact_id": {
            "type": "string",
            "pattern": "^ec_[a-f0-9]{8}$"
          },
          "contact_type": {
            "enum": [
              "emergency_service",
              "hospital",
              "person"
            ]
          },
          "phone": {
            "type": "string",
            "pattern": "^(\\+[1-9][0-9]{6,14}|[0-9]{3})$"
          },
          "org_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^org_[a-f0-9]{8}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "emergency_consent": {
        "const": false
      }
    }
  },
  "then": {
    "properties": {
      "emergency_org_ids": {
        "maxItems": 0
      },
      "emergency_contacts": {
        "maxItems": 0
      }
    }
  }
}
