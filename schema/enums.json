{
  "schema_version": "1.0",
  "roles": ["patient_device", "doctor", "caregiver", "company_reader", "company_admin", "company_safety"],
  "id_patterns": {
    "patient_ref": "^pt_[a-f0-9]{8}$",
    "record_id": "^rec_[a-f0-9]{8}$",
    "program_id": "^prog_[a-z0-9_]{1,24}$",
    "doctor_id": "^dr_[a-f0-9]{8}$",
    "caregiver_id": "^cg_[a-f0-9]{8}$",
    "alert_id": "^alt_[a-f0-9]{8}$",
    "envelope_id": "^env_[a-f0-9]{8}$",
    "config_id": "^cfg_[a-z0-9_]{1,32}$",
    "company_user_id": "^usr_[a-z0-9_]{1,24}$",
    "payload_sha256": "^[a-f0-9]{64}$"
  },
  "cohort_id": ["cohort_A", "cohort_B", "cohort_C", "cohort_D"],
  "drug_version": ["v1", "v2", "v3", "v4"],
  "checkin_status": ["completed", "partial", "missed"],
  "record_source": ["device", "scheduler"],
  "severity": ["mild", "moderate", "severe"],
  "onset": ["today", "1_3_days", "4_7_days", "over_7_days", "unknown"],
  "answer_rating": ["complete", "partial", "off_topic", "rambling", "no_answer"],
  "trend": ["better", "same", "worse", "unknown"],
  "alert_type": ["missed", "severe"],
  "caregiver_detail": ["alerts_only", "summary"],
  "link_status": ["active", "revoked"],
  "outbox_destination": ["company_record", "doctor_envelope", "alert", "consent"],
  "outbox_status": ["queued", "sent", "failed"],
  "question_purpose": ["wellbeing", "symptom_screen", "severity", "onset", "adherence", "exposure"],
  "term_code": [
    "SE_RASH",
    "SE_DRY_SKIN",
    "SE_PARONYCHIA",
    "SE_DIARRHEA",
    "SE_STOMATITIS",
    "SE_FATIGUE",
    "SE_DECREASED_APPETITE",
    "SE_INFUSION_REACTION",
    "SE_DYSPNEA",
    "SE_COUGH",
    "SE_EDEMA",
    "SE_OTHER_REVIEW"
  ]
}
