{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schema/alert_event.json",
  "title": "SentinelAlertEvent",
  "description": "Sent by the patient device to POST /v1/alerts. Devices send only 'severe'; 'missed' alerts are created by the service scheduler and never accepted from a device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alert_id", "patient_ref", "alert_type", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "alert_id": { "type": "string", "pattern": "^alt_[a-f0-9]{8}$" },
    "patient_ref": { "type": "string", "pattern": "^pt_[a-f0-9]{8}$" },
    "alert_type": { "const": "severe" },
    "created_at": { "type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$" }
  }
}
