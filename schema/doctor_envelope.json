{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schema/doctor_envelope.json",
  "title": "SentinelDoctorEnvelope",
  "description": "Sent to POST /v1/doctor-envelopes. ciphertext is a libsodium sealed box (base64, standard alphabet) of the canonical JSON of a doctor_payload; payload_sha256 is the hash of that plaintext.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_id", "doctor_id", "patient_ref", "ciphertext", "payload_sha256"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "envelope_id": { "type": "string", "pattern": "^env_[a-f0-9]{8}$" },
    "doctor_id": { "type": "string", "pattern": "^dr_[a-f0-9]{8}$" },
    "patient_ref": { "type": "string", "pattern": "^pt_[a-f0-9]{8}$" },
    "ciphertext": { "type": "string", "minLength": 64, "maxLength": 65536, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
